# --- SDD·서고 작업환경 ---
# 문서 실물은 비추적, 양식(example.md)만 추적
docs/*/*
!docs/*/example.md
# 서고: 계약·소유기록만 추적, 카드·색인·로그·캐시는 비추적
__llm-wiki/*
!__llm-wiki/contract.json
!__llm-wiki/receipt.json
# 시드(설치 명세 원본)는 비추적
seed/
# API KEY 폴더
# envs/ 아래 키 파일(*.env · *.env.*)은 비추적 — README.md 와 키 이름만 담은 양식(*.env.example)은 추적
envs/**/*.env
envs/**/*.env.*
!envs/**/*.env.example
# 시크릿은 Infisical에서 주입. 루트/하위 앱의 실수로 만든 env도 차단한다.
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
!.env.template
node_modules/
# 프론트 빌드·검증 산출물
web/dist/
web/test-results/
web/playwright-report/
# 팀 공유 문서(전략·외부 조사)는 실물도 추적
!docs/strategy/
!docs/strategy/**
!docs/research/
!docs/research/**
# Python·라이브서버 작업 공간 (spec §2.5) — pytest 트리·임시 산출물은 비추적
# tests/ 전체가 아니라 그 안을 막는다 — 팀 공유 시크릿 테스트(tests/secrets/)는 추적한다
tests/*
!tests/secrets/
!tests/discovery/
!tests/auth/
!tests/live/
temp/
tmp/
.venv/
__pycache__/
.pytest_cache/
