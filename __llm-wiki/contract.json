{
  "schema_version": 1,
  "project_name": "heak",
  "wiki_dir": "__llm-wiki",
  "source_roots": ["docs/interview", "docs/plan", "docs/devlog", "docs/checklist", "docs/strategy", "docs/research"],
  "excluded_roots": ["docs/interview/example.md", "docs/plan/example.md", "docs/devlog/example.md", "docs/checklist/example.md", "docs/strategy/example.md", "docs/research/example.md"],
  "source_suffixes": [".md"],
  "authority_rules": [
    { "pattern": "docs/checklist/**", "document_type": "checklist", "authority_rank": 100, "role": "validation-verdict" },
    { "pattern": "docs/devlog/**", "document_type": "devlog", "authority_rank": 85, "role": "execution-narrative" },
    { "pattern": "docs/plan/**", "document_type": "plan", "authority_rank": 55, "role": "plan" },
    { "pattern": "docs/interview/**", "document_type": "interview", "authority_rank": 40, "role": "intent" },
    { "pattern": "docs/strategy/**", "document_type": "strategy", "authority_rank": 45, "role": "team-strategy" },
    { "pattern": "docs/research/**", "document_type": "research", "authority_rank": 30, "role": "external-research" }
  ],
  "fallback": { "document_type": "reference", "authority_rank": 0, "role": "reference" },
  "copy_policy": "path_reference",
  "frontmatter_aliases": {},
  "filename_pattern": "^(?<prefix>[a-z][a-z_]*)_(?<yymmddhh>\\d{8})(?:_\\d{2}_\\d{2})?_(?<title>.+)\\.md$",
  "layout": { "cards_dir": "cards", "cache_dir": ".cache", "archive_dir": "archive" },
  "search": {
    "bm25_k1": 1.2, "bm25_b": 0.75,
    "field_boost": { "title": 3, "heading": 2, "meta": 1.5, "body": 1 },
    "authority_weight": 0.01, "span_max_lines": 40, "result_limit": 10, "spans_per_result": 2
  },
  "naming": { "docs_root": "docs", "doc_types": ["interview", "plan", "devlog", "checklist", "strategy", "research"], "utc_offset": "+09:00" },
  "upstream_rules": [
    { "pattern": "docs/plan/**", "key": "upstream" },
    { "pattern": "docs/devlog/**", "key": "upstream" },
    { "pattern": "docs/checklist/**", "key": "upstream" },
    { "pattern": "docs/research/**", "key": "upstream" }
  ]
}
